@model OnlineShop.Models.Product

@{
    ViewData["Title"] = "Create Product";
}

<h2>Create New Product</h2>

@if (TempData["ProductSaved"] is string message)
{
    <p class="alert alert-success" role="status">@message</p>
}

<form asp-controller="Product" asp-action="Create" method="post">
    <div>
        <label asp-for="Name"></label><br />
        <input asp-for="Name" required />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="Description"></label><br />
        <textarea asp-for="Description"></textarea>
    </div>
    <div>
        <label asp-for="Price"></label><br />
        <input asp-for="Price" type="number" min="0" step="0.01" required />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <br />
    <button type="submit">Save</button>
</form>
